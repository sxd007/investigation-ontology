          "frequency": "业务发生时",
          "execution_mode": "人工控制",
          "importance": "一般控制"
        },
        {
          "control_ref": "ITS-C03",
          "measure": "企业信息系统归口管理部门应当组织内部各单位提出开发需求和关键控制点，规范开发流程，明确系统设计、编程、安装调试、验收、上线等全过程的管理要求，严格按照建设方案、开发流程和相关要求组织开发工作。",
          "guideline_refs": [
            "应用指引第五条"
          ],
          "frequency": "业务发生时",
          "execution_mode": "人工控制",
          "importance": "一般控制"
        },
        {

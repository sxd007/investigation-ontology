{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ontology/schemas/parsed-document.schema.json",
  "title": "ParsedDocument",
  "description": "Vendored parsed schema 0.1.0 from ontology_framework (2026-08-25).",
  "type": "object",
  "required": ["parsedSchemaVersion", "document", "blocks", "coverage"],
  "additionalProperties": false,
  "properties": {
    "parsedSchemaVersion": {"type": "string", "const": "0.1.0"},
    "document": {
      "type": "object",
      "required": ["docId", "rawRef"],
      "additionalProperties": false,
      "properties": {
        "docId": {"type": "string", "minLength": 1},
        "rawRef": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docNumber": {"type": "string"},
            "title": {"type": "string"},
            "issuingAuthority": {"type": "string"},
            "effectiveDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "coverage": {
      "type": "object",
      "required": ["clauseSequence", "blockCount", "unrecognizedRegions", "parser"],
      "additionalProperties": false,
      "properties": {
        "clauseSequence": {
          "type": "object",
          "required": ["detected", "gaps", "status"],
          "additionalProperties": false,
          "properties": {
            "declared": {"type": ["array", "null"], "items": {"type": "integer"}},
            "detected": {"type": "array", "items": {"type": "integer"}},
            "gaps": {"type": "array", "items": {"type": "integer"}},
            "status": {"enum": ["OK", "SUSPECT", "NO_CLAUSES"]}
          }
        },
        "blockCount": {
          "type": "object",
          "required": ["parsed"],
          "additionalProperties": false,
          "properties": {
            "estimated": {"type": ["integer", "null"], "minimum": 0},
            "parsed": {"type": "integer", "minimum": 0}
          }
        },
        "tocCrosscheck": {
          "type": "object",
          "required": ["hasToc"],
          "additionalProperties": false,
          "properties": {
            "hasToc": {"type": "boolean"},
            "matched": {"type": ["string", "null"]},
            "orphanSections": {"type": "array", "items": {"type": "string"}}
          }
        },
        "unrecognizedRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "reason"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["table", "footnote", "image", "header-footer", "other"]},
              "pageHint": {"type": "integer", "minimum": 1},
              "blockPath": {"type": "string"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "parser": {
          "type": "object",
          "required": ["engine", "timestamp"],
          "additionalProperties": false,
          "properties": {
            "engine": {"type": "string"},
            "model": {"type": ["string", "null"]},
            "timestamp": {"type": "string"}
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["profileVersion"],
        "properties": {"profileVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}}
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": ["blockPath", "charStart", "charEnd", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "blockPath": {"type": "string", "minLength": 1},
        "charStart": {"type": "integer", "minimum": 0},
        "charEnd": {"type": "integer", "minimum": 0},
        "pageHint": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "block": {
      "type": "object",
      "required": ["blockId", "blockType", "text", "anchor"],
      "additionalProperties": false,
      "properties": {
        "blockId": {"type": "string", "minLength": 1},
        "blockType": {"enum": ["heading", "clause", "paragraph", "table", "listItem"]},
        "text": {"type": "string"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "headingLevel": {"type": "integer", "minimum": 0},
        "clauseRef": {
          "type": "object",
          "required": ["number", "index"],
          "additionalProperties": false,
          "properties": {
            "number": {"type": "string"},
            "index": {"type": "integer", "minimum": 1},
            "para": {"type": "integer", "minimum": 1}
          }
        },
        "table": {
          "type": "object",
          "required": ["grid"],
          "additionalProperties": false,
          "properties": {
            "grid": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": ["string", "null"]}}},
            "headerRows": {"type": "integer", "minimum": 0},
            "mergedCells": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["range"],
                "properties": {"range": {"type": "string"}, "note": {"type": ["string", "null"]}}
              }
            }
          }
        },
        "parseConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "needsVerification": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"blockType": {"const": "table"}}}, "then": {"required": ["table"]}}]
    }
  }
}
